PORT=4000
CONTROLLER_STATE_FILE=./data/controller-state.json
STAMP_IDEMPOTENCY_TTL_MS=21600000
STAMP_IDEMPOTENCY_MAX_RECORDS=2000
WINNER_GRACE_PERIOD_SECONDS=30
# Multi-tenant routing controls.
MULTI_TENANT_ENABLED=false
LEGACY_SINGLE_TENANT_FALLBACK=true
# Optional explicit default tenant slug. If blank, controller derives it from TWITCH_BROADCASTER_ID.
DEFAULT_TENANT_SLUG=
# Optional migration fallback bearer token for /api/mod/* routes.
MOD_CONTROL_TOKEN=
# Twitch OAuth app settings used for viewer login and moderator auth.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=
TWITCH_OAUTH_SCOPE=
TWITCH_BROADCASTER_ID=
# Optional JSON map of tenant slug -> broadcaster user id. Tenant mapping is checked first, then TWITCH_BROADCASTER_ID is used as fallback.
# Example: {"streamer-a":"12345","streamer-b":"67890"}
TENANT_BROADCASTER_OVERRIDES=
# Optional first-claim registration: when true, first successful mod Twitch sign-in for an unmapped tenant writes tenant -> broadcaster mapping to persistent storage.
# Keep false for strict admin-managed mapping; enable only if you accept first-claim onboarding semantics.
TENANT_BROADCASTER_AUTO_REGISTER=false
MOD_AUTH_SESSION_SECRET=
# Optional shared cookie domain for mod auth sessions across subdomains (example: custom-overlays.com).
# Leave blank to keep the mod_auth cookie host-only.
MOD_AUTH_COOKIE_DOMAIN=
MOD_AUTH_SESSION_TTL_MS=43200000
MOD_AUTH_ALLOW_LEGACY_TOKEN=true
TWITCH_MOD_REDIRECT_URI=
TWITCH_MOD_OAUTH_SCOPE=user:read:moderated_channels
# Owner-only management auth (tenant mappings + tenant redeem keys).
OWNER_AUTH_ENABLED=true
OWNER_AUTH_SESSION_SECRET=
OWNER_TWITCH_USER_IDS=
OWNER_AUTH_REDIRECT_URI=
OWNER_AUTH_OAUTH_SCOPE=
OWNER_AUTH_COOKIE_DOMAIN=
OWNER_AUTH_SESSION_TTL_MS=43200000
# Optional reserved keys for external EventSub/reward integrations.
TWITCH_BOT_USERNAME=
TWITCH_BOT_OAUTH=
TWITCH_CHANNEL=
TWITCH_CHANNELS=
TWITCH_EVENTSUB_USER_ACCESS_TOKEN=
TWITCH_JOIN_REWARD_ID=
# Public API/viewer URLs used to build redeem and auth redirect links.
PUBLIC_API_BASE_URL=
VIEWER_BASE_URL=
VIEWER_INVITE_TOKEN_SECRET=
VIEWER_AUTH_TOKEN_SECRET=
# Viewer token lifetimes should be long enough to cover full stream rounds/events.
# Defaults below target stream-safe behavior: invite=8h, auth=24h.
VIEWER_INVITE_TOKEN_TTL_MS=28800000
VIEWER_AUTH_TOKEN_TTL_MS=86400000
TWITCH_OAUTH_STATE_TTL_MS=600000
# Legacy fallback token accepted by redeem endpoints when LEGACY_INTERNAL_REDEEM_SECRET_ENABLED=true.
INTERNAL_REDEEM_SECRET=
# Set false after all redeemers have moved to tenant-scoped redeem keys.
LEGACY_INTERNAL_REDEEM_SECRET_ENABLED=true
# Hash cost used for tenant redeem key verification at rest.
TENANT_REDEEM_KEY_HASH_ITERATIONS=120000
# Comma-separated origin allowlist for browser clients (overlay/viewer/control/custom domains).
ALLOWED_ORIGINS=
# Example public custom-domain origins:
# ALLOWED_ORIGINS=https://public-controller.custom-overlays.com,https://public-overlay.custom-overlays.com,https://bingo-owner.custom-overlays.com,https://public-card.custom-overlays.com

# Frontend build-time variables (set in app-specific .env.production files)
# apps/overlay/.env.production => VITE_API_BASE_URL=https://public-control.custom-overlays.com
# apps/viewer/.env.production  => VITE_API_BASE_URL=https://public-control.custom-overlays.com
# apps/control/.env.production => VITE_API_BASE_URL=https://public-control.custom-overlays.com
# apps/owner/.env.production   => VITE_API_BASE_URL=https://public-control.custom-overlays.com
# apps/control/.env.production => VITE_CONTROL_ALLOWED_HOSTS=public-controller.custom-overlays.com,control.custom-overlays.com
# apps/control/.env.production => VITE_MOD_CONTROL_TOKEN=<optional legacy fallback token>
